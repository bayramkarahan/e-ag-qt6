####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/usr/bin || mkdir -p $(INSTALL_ROOT)/usr/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/usr/bin/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/usr/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/usr/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/bin/ 


install_service: first FORCE
	@test -d $(INSTALL_ROOT)/lib/systemd/system/ || mkdir -p $(INSTALL_ROOT)/lib/systemd/system/
	$(QINSTALL_PROGRAM) /home/etapadmin/Masaüstü/e-ag-qt6/dds/dds-service/data/dds-service.service $(INSTALL_ROOT)/lib/systemd/system/dds-service.service
	-strip $(INSTALL_ROOT)/lib/systemd/system/dds-service.service

uninstall_service: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/lib/systemd/system/dds-service.service
	-$(DEL_DIR) $(INSTALL_ROOT)/lib/systemd/system/ 


install_scriptscript: first FORCE
	@test -d $(INSTALL_ROOT)/usr/share/dds/ || mkdir -p $(INSTALL_ROOT)/usr/share/dds/
	$(QINSTALL_PROGRAM) /home/etapadmin/Masaüstü/e-ag-qt6/dds/dds-service/data/dds-debinstaller $(INSTALL_ROOT)/usr/share/dds/dds-debinstaller
	-strip $(INSTALL_ROOT)/usr/share/dds/dds-debinstaller

uninstall_scriptscript: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/dds/dds-debinstaller
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/share/dds/ 


install_scriptscriptservice: first FORCE
	@test -d $(INSTALL_ROOT)/lib/systemd/system/ || mkdir -p $(INSTALL_ROOT)/lib/systemd/system/
	$(QINSTALL_PROGRAM) /home/etapadmin/Masaüstü/e-ag-qt6/dds/dds-service/data/dds-scriptexec@.service $(INSTALL_ROOT)/lib/systemd/system/dds-scriptexec@.service
	-strip $(INSTALL_ROOT)/lib/systemd/system/dds-scriptexec@.service

uninstall_scriptscriptservice: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/lib/systemd/system/dds-scriptexec@.service
	-$(DEL_DIR) $(INSTALL_ROOT)/lib/systemd/system/ 


install_debscript: first FORCE
	@test -d $(INSTALL_ROOT)/usr/share/dds/ || mkdir -p $(INSTALL_ROOT)/usr/share/dds/
	$(QINSTALL_PROGRAM) /home/etapadmin/Masaüstü/e-ag-qt6/dds/dds-service/data/dds-scriptexec $(INSTALL_ROOT)/usr/share/dds/dds-scriptexec
	-strip $(INSTALL_ROOT)/usr/share/dds/dds-scriptexec

uninstall_debscript: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/dds/dds-scriptexec
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/share/dds/ 


install_debscriptservice: first FORCE
	@test -d $(INSTALL_ROOT)/lib/systemd/system/ || mkdir -p $(INSTALL_ROOT)/lib/systemd/system/
	$(QINSTALL_PROGRAM) /home/etapadmin/Masaüstü/e-ag-qt6/dds/dds-service/data/dds-debinstaller@.service $(INSTALL_ROOT)/lib/systemd/system/dds-debinstaller@.service
	-strip $(INSTALL_ROOT)/lib/systemd/system/dds-debinstaller@.service

uninstall_debscriptservice: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/lib/systemd/system/dds-debinstaller@.service
	-$(DEL_DIR) $(INSTALL_ROOT)/lib/systemd/system/ 


install: install_target install_service install_scriptscript install_scriptscriptservice install_debscript install_debscriptservice  FORCE

uninstall: uninstall_target uninstall_service uninstall_scriptscript uninstall_scriptscriptservice uninstall_debscript uninstall_debscriptservice  FORCE

