####### Compile

main.o: main.cpp monitorclient.h \
		type.h \
		Database.h \
		userprivilegehelper.h \
		roledialog.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

monitorclient.o: monitorclient.cpp monitorclient.h \
		type.h \
		Database.h \
		userprivilegehelper.h \
		roledialog.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o monitorclient.o monitorclient.cpp

roledialog.o: roledialog.cpp roledialog.h \
		Database.h \
		type.h \
		userprivilegehelper.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o roledialog.o roledialog.cpp

userprivilegehelper.o: userprivilegehelper.cpp userprivilegehelper.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o userprivilegehelper.o userprivilegehelper.cpp

qrc_icons.o: qrc_icons.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o qrc_icons.o qrc_icons.cpp

moc_monitorclient.o: moc_monitorclient.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_monitorclient.o moc_monitorclient.cpp

moc_roledialog.o: moc_roledialog.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_roledialog.o moc_roledialog.cpp

moc_userprivilegehelper.o: moc_userprivilegehelper.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_userprivilegehelper.o moc_userprivilegehelper.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/usr/bin || mkdir -p $(INSTALL_ROOT)/usr/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/usr/bin/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/usr/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/usr/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/bin/ 


install_nemomenu: first FORCE
	@test -d $(INSTALL_ROOT)/usr/share/nemo/actions/ || mkdir -p $(INSTALL_ROOT)/usr/share/nemo/actions/
	$(QINSTALL_PROGRAM) /home/etapadmin/Masaüstü/e-ag-qt6/dds/dds-monitor/data/nemomenu/dds-send.nemo_action $(INSTALL_ROOT)/usr/share/nemo/actions/dds-send.nemo_action
	-strip $(INSTALL_ROOT)/usr/share/nemo/actions/dds-send.nemo_action

uninstall_nemomenu: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/nemo/actions/dds-send.nemo_action
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/share/nemo/actions/ 


